# ─────────────────────────────────────────────────────────────────────────────
# YatraTrack Backend — Environment Variables
# Copy this file to .env and fill in real values.  Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Core
APP_ENV=dev
APP_TIMEZONE=Asia/Kolkata
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_real_64_char_hex_secret_key_at_least_32_bytes_long
FRONTEND_URL=http://localhost:5173

# Database
# Inside Docker Compose:  postgresql+asyncpg://yatratrack:yatratrack_dev@db:5432/yatratrack
# Local dev (outside Docker, port 5432 forwarded): postgresql+asyncpg://yatratrack:yatratrack_dev@localhost:5432/yatratrack
DATABASE_URL=postgresql+asyncpg://yatratrack:yatratrack_dev@localhost:5432/yatratrack
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Redis
# Inside Docker Compose:  redis://redis:6379/0
# Local dev (outside Docker): redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Auth
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_TTL_MIN=15
BCRYPT_ROUNDS=12

# Email (transactional — Resend)
RESEND_API_KEY=re_placeholder_fill_before_testing_email
EMAIL_FROM=YatraTrack <no-reply@yatratrack.in>

# Maps / Geocoding (optional in dev)
STADIA_API_KEY=
MAPTILER_API_KEY=

# Observability (optional in dev)
SENTRY_DSN=
LOG_LEVEL=DEBUG
LOG_RETENTION_DAYS=30

# Scheduling
TRIP_AUTOGEN_ENABLED=true
TRIP_AUTOGEN_HOUR=6
SCHOOL_HOURS_START=6
SCHOOL_HOURS_END=18

# GPS
GPS_FLUSH_INTERVAL_SEC=30
GPS_STALE_THRESHOLD_SEC=30
GPS_RETENTION_DAYS=90
